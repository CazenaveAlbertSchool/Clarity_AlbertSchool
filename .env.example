# Google Cloud Project
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=eu-west1

# Utilise l'authentification par défaut (pas de clé JSON requise)
GOOGLE_APPLICATION_CREDENTIALS=""

# Document AI (à remplir après la création du processeur)
DOCUMENTAI_PROCESSOR_ID=  # Laisser vide pour l'instant

# Google Cloud Storage (optionnel)
GCS_BUCKET_NAME=clarity-documents-bucket

# Autres variables utiles
FLASK_ENV=development
PORT=5000
USE_GCLOUD_AUTH=true  # Active l'authentification via gcloud